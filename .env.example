# Local PostgreSQL database (matches docker-compose.yml)
DATABASE_URL="postgresql://cashflow:cashflow_dev_only@localhost:5432/cashflow_dev?schema=public"

# NextAuth authentication secret & base URL
NEXTAUTH_SECRET="change-this-to-a-secure-random-secret-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Application environment
NODE_ENV="development"
