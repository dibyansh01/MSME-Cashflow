generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   // OWNER, ACCOUNTS, SALES
  createdAt DateTime @default(now())
}

model Customer {
  id          String   @id @default(uuid())
  name        String
  phone       String?
  email       String?
  creditTerms Int?
  createdAt   DateTime @default(now())

  invoices    Invoice[]
}


model Invoice {
  id            String   @id @default(uuid())
  customerId    String
  invoiceNo     String
  invoiceDate   DateTime
  dueDate       DateTime

  invoiceAmount Float
  paidAmount    Float    @default(0)
  outstandingAmount Float

  status        String   // UNPAID, PARTIAL, PAID, OVERDUE
  createdAt     DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  followUps FollowUp[]   

  @@index([customerId])
  @@index([dueDate])
  @@index([status])
}

model FollowUp {
  id              String   @id @default(uuid())
  invoiceId       String
  followUpDate    DateTime @default(now())
  method          String   // CALL, WHATSAPP, EMAIL, VISIT
  status          String   // PROMISED, NO_RESPONSE, PAID, DISPUTED
  notes           String?
  nextFollowUpOn  DateTime?
  createdAt       DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}


