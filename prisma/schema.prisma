generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Represents a system user with access roles
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   // OWNER, ACCOUNTS, SALES
  createdAt DateTime @default(now())
}

/// Represents a client or customer of the business
model Customer {
  id          String   @id @default(uuid())
  name        String
  phone       String?
  email       String?
  creditTerms Int?     // Number of days for credit
  createdAt   DateTime @default(now())

  invoices    Invoice[]
}

/// Represents an invoice generated for a customer
model Invoice {
  id            String   @id @default(uuid())
  customerId    String
  invoiceNo     String   // Unique invoice number
  invoiceDate   DateTime
  dueDate       DateTime
  
  invoiceAmount Float
  paidAmount    Float    @default(0)
  outstandingAmount Float // Remaining amount to be paid

  status        String   // UNPAID, PARTIAL, PAID, OVERDUE
  createdAt     DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  followUps FollowUp[]   
  payments   PaymentEntry[] 
  @@index([customerId])
  @@index([dueDate])
  @@index([status])
}

/// Represents a follow-up action taken for an invoice
model FollowUp {
  id              String   @id @default(uuid())
  invoiceId       String
  followUpDate    DateTime @default(now())
  method          String   // CALL, WHATSAPP, EMAIL, VISIT
  status          String   // PROMISED, NO_RESPONSE, PAID, DISPUTED
  notes           String?
  nextFollowUpOn  DateTime?
  createdAt       DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

/// Represents a payment received for an invoice
model PaymentEntry {
  id          String   @id @default(uuid())
  invoiceId  String
  amount     Float
  paymentDate DateTime @default(now())
  method      String   // CASH, UPI, BANK, CHEQUE, OTHER
  reference   String?  // Transaction ID or Cheque Number
  notes       String?
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}
